# Application Configuration
APP_NAME=HDFS Gateway API
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=5005

# Hadoop WebHDFS Configuration
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_USER=suveer
HDFS_DEFAULT_DIR=/
HDFS_TIMEOUT_SECONDS=30

# Real-Time Streaming & Vision Client Configuration (v2)
# When running the vision client on your host machine (Mac/Windows/Linux)
# connecting to an external Linux VM or remote Kafka broker, set KAFKA_BOOTSTRAP_SERVERS
# to the reachable broker address (e.g., 192.168.1.X:9092). For local Docker, use localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_TOPIC=vision-events

# Camera & Detection Settings
CAMERA_ID=camera-01
CAMERA_SOURCE=0
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.5
