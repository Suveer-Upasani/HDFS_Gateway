# Application Configuration
APP_NAME=HDFS Gateway API
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=5005

# Hadoop WebHDFS Configuration
# URL of your existing Hadoop NameNode WebHDFS endpoint (e.g. http://192.168.1.100:9870 or http://localhost:9870)
HDFS_NAMENODE_URL=http://<HADOOP_NAMENODE>:9870
HDFS_USER=hadoop
HDFS_DEFAULT_DIR=/
HDFS_TIMEOUT_SECONDS=30
